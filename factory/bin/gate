#!/bin/sh
''':'
# Start with the first Python 3.10+ on PATH: python3, or python or py on Windows.
for p in python3 python py; do
  "$p" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null && exec "$p" "$0" "$@"
done
echo "factory: needs Python 3.10 or later on PATH, as python3, python or py" >&2
exit 1
'''
__doc__ = """The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job-id>            write round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate <job-id> --merge    same, as round-N/merge-checks.md (job merge runs it)
  gate <job-id> --try      run the same checks and print the verdict; writes nothing
  gate --hook              builder SubagentStop hook: run the checks once, exit 2 on failure

The gate runs the job's repo's checks script, kept outside the job's branch
(factory/checks.sh in a single repo, factory/checks/<repo>.sh in a workspace),
inside the job's worktree, so a branch can't change the checks it is judged
by. It also fails when the branch modifies or deletes a file matching the
repo's `protected_paths` (fnmatch patterns, where `*` also matches `/`).
Adding new files is fine.
"""

import fnmatch
import json
import subprocess
import sys
import time
from pathlib import Path

# Windows gives pipes its ANSI code page (cp1252), which can't hold most of
# Unicode; issue text, agent output and check logs can. Speak UTF-8 instead.
for _stream in (sys.stdin, sys.stdout, sys.stderr):
    if _stream is not None:
        _stream.reconfigure(encoding="utf-8", errors="replace")

ROOT = Path(__file__).resolve().parents[2]
FACTORY = ROOT / "factory"
CONFIG = json.loads((FACTORY / "config.json").read_text(encoding="utf-8"))
TAIL = 80

sys.path.insert(0, str(FACTORY / "lib"))
import shell  # noqa: E402
import workspace  # noqa: E402


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True, encoding="utf-8", errors="replace")
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def load_job(job_id):
    path = FACTORY / "jobs" / job_id / "job.json"
    if not path.exists():
        die(f"no job {job_id}")
    job = json.loads(path.read_text(encoding="utf-8"))
    try:
        repo = workspace.Workspace(CONFIG, ROOT).for_job(job)
    except workspace.WorkspaceError as e:
        die(str(e))
    if repo is None or not job.get("worktree"):
        die(f"{job_id} has no repo and worktree yet")
    return job, repo


def protected_changes(worktree, repo):
    """Existing files under protected_paths that the branch modified or deleted."""
    diff = git(worktree, "diff", "--name-status", f"origin/{repo.base}...HEAD")
    hits = []
    for line in diff.splitlines():
        status, *paths = line.split("\t")
        if status.startswith("A"):
            continue
        old = paths[0]  # for renames and copies, the original path
        if any(fnmatch.fnmatch(old, pattern) for pattern in repo.protected_paths):
            hits.append(f"{status[0]} {old}")
    return hits


def run_checks(worktree, repo):
    if not repo.checks.exists():
        die(f"no checks script for {repo.name}: {repo.checks}")
    # Read it ourselves so Windows CRLF line endings can't break bash.
    script = repo.checks.read_text(encoding="utf-8").replace("\r\n", "\n")
    start = time.monotonic()
    try:
        bash = shell.find_bash(CONFIG)  # Git Bash on Windows, never WSL's System32 bash
    except shell.ShellError as e:
        die(str(e))
    res = subprocess.run([bash, "-c", script, str(repo.checks)], cwd=worktree, capture_output=True, text=True, encoding="utf-8", errors="replace")
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def gate(job_id, mode):
    job, repo = load_job(job_id)
    worktree = job["worktree"]
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    commit = git(worktree, "rev-parse", "HEAD").strip()
    protected = protected_changes(worktree, repo)
    code, log, seconds = run_checks(worktree, repo)
    verdict = "PASS" if code == 0 and not protected else "FAIL"
    detail = (f"checks exit {code} in {seconds}s"
              + (f", protected paths changed: {', '.join(protected)}" if protected else ""))
    if mode == "try":
        tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
        print(f"GATE: {verdict} ({job_id}, {detail})\n\n{tail}")
        sys.exit(0 if verdict == "PASS" else 1)
    round_dir = FACTORY / "jobs" / job_id / f"round-{job['round']}"
    name = "merge-checks" if mode == "merge" else "checks"
    (round_dir / f"{name}.log").write_text(log, encoding="utf-8")
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    summary = [
        f"{repo.checks.name} {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s",
        f"Protected paths: {'changed: ' + ', '.join(protected) if protected else 'none changed'}",
        f"Commit {commit[:7]}" + (f", synced with the latest {repo.base} before merging" if mode == "merge" else ""),
    ]
    (round_dir / f"{name}.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\n\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + f"\n\n## {repo.checks.name}\nExit {code} in {seconds}s. Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n",
        encoding="utf-8")
    print(f"GATE: {verdict} ({job_id} round {job['round']}, {detail})")
    sys.exit(0 if verdict == "PASS" else 1)


def hook():
    event = json.load(sys.stdin)
    if event.get("stop_hook_active"):
        sys.exit(0)  # one nudge per stop; the gate decides
    with open(Path(event["agent_transcript_path"]).expanduser(), encoding="utf-8") as f:
        content = json.loads(f.readline())["message"]["content"]
    prompt = content if isinstance(content, str) else " ".join(b.get("text", "") for b in content)
    job_id = prompt.split("Job: ", 1)[1].split(".", 1)[0]
    job, repo = load_job(job_id)
    code, log, _ = run_checks(job["worktree"], repo)
    if code != 0:
        tail = "\n".join(log.rstrip().splitlines()[-40:])
        print(f"The repo's checks fail in your worktree (exit {code}). The gate will reject this "
              f"build. Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n{tail}",
              file=sys.stderr)
        sys.exit(2)


def main(argv):
    if argv == ["--hook"]:
        hook()
    elif len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0], "check")
    elif len(argv) == 2 and argv[1] in ("--merge", "--try"):
        gate(argv[0], argv[1][2:])
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
